# ──────────────────────────────────────────────────────────────────────
# ConstructSync Environment Configuration
# ──────────────────────────────────────────────────────────────────────

# Core Pipeline Configuration
CONSTRUCTSYNC_HOST=0.0.0.0
CONSTRUCTSYNC_PORT=8000
CONSTRUCTSYNC_DEBUG=true

# Constructor API Credentials
CONSTRUCTOR_API_KEY=test_api_key_12345
CONSTRUCTOR_BASE_URL=http://constructor-mock:8001

# Concurrency & Ingestion Settings
DEFAULT_BATCH_SIZE=1000
INITIAL_CONCURRENCY=4
MAX_CONCURRENCY=32
MIN_CONCURRENCY=1

# SQLite Database Paths
DLQ_DATABASE_PATH=dlq/dlq.db
HASH_STORE_DATABASE_PATH=data/hashes.db

# Optional Services Configuration
# KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# OPENAI_API_KEY=your_openai_key_here
